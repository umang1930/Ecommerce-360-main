# Amazon Selling Partner API production credentials (Amazon India)
# Copy these names to the untracked server .env and replace placeholders there.
# Never put real credentials in this template or in VITE_* variables.
AMAZON_SP_API_CLIENT_ID=your_claspo_amazon_lwa_client_id
AMAZON_SP_API_CLIENT_SECRET=your_claspo_amazon_lwa_client_secret
AMAZON_SP_API_REFRESH_TOKEN=your_claspo_amazon_refresh_token
AMAZON_SP_API_AWS_SECRET_ACCESS_KEY=your_claspo_aws_secret_access_key
AMAZON_SP_API_AWS_ACCESS_KEY_ID=your_claspo_aws_access_key_id
# Only set when using temporary AWS credentials.
AMAZON_SP_API_AWS_SESSION_TOKEN=
AMAZON_SP_API_ENDPOINT=https://sellingpartnerapi-eu.amazon.com
AMAZON_SP_API_AWS_REGION=eu-west-1
AMAZON_SP_API_MARKETPLACE_ID=A21TJRUUN4KGV
# Optional override; defaults to the Claspo report ID currently provided.
AMAZON_SP_API_RETURNS_REPORT_ID=50263020748

# Monkeyman Amazon SP-API (separate seller account; optional)
AMAZON_SP_API_MONKEYMAN_CLIENT_ID=your_monkeyman_amazon_lwa_client_id
AMAZON_SP_API_MONKEYMAN_CLIENT_SECRET=your_monkeyman_amazon_lwa_client_secret
AMAZON_SP_API_MONKEYMAN_REFRESH_TOKEN=your_monkeyman_amazon_refresh_token
AMAZON_SP_API_MONKEYMAN_AWS_SECRET_ACCESS_KEY=your_monkeyman_aws_secret_access_key
AMAZON_SP_API_MONKEYMAN_AWS_ACCESS_KEY_ID=your_monkeyman_aws_access_key_id
# Only set when using temporary AWS credentials.
AMAZON_SP_API_MONKEYMAN_AWS_SESSION_TOKEN=
AMAZON_SP_API_MONKEYMAN_ENDPOINT=https://sellingpartnerapi-eu.amazon.com
AMAZON_SP_API_MONKEYMAN_AWS_REGION=eu-west-1
AMAZON_SP_API_MONKEYMAN_MARKETPLACE_ID=A21TJRUUN4KGV
# Optional override; defaults to the Monkeyman report ID currently provided.
AMAZON_SP_API_MONKEYMAN_RETURNS_REPORT_ID=50539020748

# Flipkart Seller API (optional; store credentials only in server .env)
FLIPKART_APP_ID=your_flipkart_app_id
FLIPKART_APP_SECRET=your_flipkart_app_secret
FLIPKART_REFRESH_TOKEN=
FLIPKART_API_ENDPOINT=https://api.flipkart.net/sellers/v2/orders/search

# Monkeyman Flipkart Seller API (separate seller account; optional)
FLIPKART_MONKEYMAN_APP_ID=your_monkeyman_flipkart_app_id
FLIPKART_MONKEYMAN_APP_SECRET=your_monkeyman_flipkart_app_secret
FLIPKART_MONKEYMAN_REFRESH_TOKEN=
FLIPKART_MONKEYMAN_API_ENDPOINT=https://api.flipkart.net/sellers/v2/orders/search

# Dashboard login (set real values only in the untracked server .env)
DASHBOARD_ADMIN_EMAIL=your_admin_email
DASHBOARD_ADMIN_PASSWORD=your_admin_password

# PostgreSQL connection (for example, the DATABASE_URL provided by a Vercel Neon integration)
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Local phpMyAdmin / MariaDB connection (use this OR a PostgreSQL URL for local development)
# Create the ecommerce360_orders database first in phpMyAdmin.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=ecommerce360_orders

# Protects the Vercel daily order-sync endpoint. Set a random secret in Vercel Environment Variables.
CRON_SECRET=replace_with_a_long_random_secret
